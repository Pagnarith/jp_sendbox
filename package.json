{
  "name": "jp-sendbox",
  "version": "0.1.0",
  "private": true,
  "description": "Mock testing environment mirroring JP (Sreypich Chan) UI/network with test credentials and mock data for Cloud soft-switch failover debugging",
  "scripts": {
    "dev": "next dev --port 3099",
    "build": "next build",
